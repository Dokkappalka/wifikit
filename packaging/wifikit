#!/bin/sh
# Лаунчер GUI. install.sh подставляет @PY@ и @PREFIX@; из репозитория работает как есть.
PY="@PY@"
PREFIX="@PREFIX@"

case "$PY" in
  @*) PY="$(command -v python3)" ;;
esac
case "$PREFIX" in
  @*) PREFIX="$(cd "$(dirname "$0")/.." && pwd)" ;;
esac

if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  echo "wifikit: нет графической сессии (DISPLAY/WAYLAND_DISPLAY)" >&2
  exit 1
fi

exec "$PY" "$PREFIX/app/main.py" "$@"
