#!/bin/sh
# qt-probe: найти, на каком шаге падает Qt, не трогая реальное железо.
#
# Каждый шаг — отдельный процесс: падение (в том числе SIGSEGV/SIGBUS) не мешает
# проверить следующие шаги. Вывод — таблица «шаг → код возврата».
#
# Запуск: qt-probe            (или: PY=/path/to/python qt-probe)
set +e

PY="${PY:-/usr/lib/wifikit/venv/bin/python}"
[ -x "$PY" ] || PY="$(command -v python3)"
ROOT="${WIFIKIT_ROOT:-/usr/lib/wifikit}"
OUT="${1:-$HOME/wifikit-qt-probe.txt}"

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
export WIFIKIT_NO_DAEMON=1
export PYTHONPATH="$ROOT"

step() {
  name="$1"; shift
  log="/tmp/qt-probe-$name.log"
  timeout 60 "$@" >"$log" 2>&1
  rc=$?
  case $rc in
    0)   verdict="ok" ;;
    139) verdict="ПАДЕНИЕ (SIGSEGV)" ;;
    135) verdict="ПАДЕНИЕ (SIGBUS)" ;;
    134) verdict="ПАДЕНИЕ (SIGABRT)" ;;
    124) verdict="таймаут" ;;
    *)   verdict="код $rc" ;;
  esac
  printf '%-28s %s\n' "$name" "$verdict" >>"$OUT"
  if [ "$rc" -ne 0 ]; then
    echo "--- $name ($verdict), последние строки: ---" >>"$OUT"
    tail -6 "$log" >>"$OUT"
    echo >>"$OUT"
  fi
  printf '%-28s %s\n' "$name" "$verdict"
}

: >"$OUT"
{
  echo "qt-probe"
  date -u
  echo "python: $PY"
  "$PY" -V 2>&1
  "$PY" -c 'import PySide6; print("PySide6", PySide6.__version__)' 2>&1
  echo "QT_QPA_PLATFORM=$QT_QPA_PLATFORM"
  echo
} >>"$OUT"

step "01.import"        "$PY" -c 'import PySide6.QtCore, PySide6.QtGui, PySide6.QtWidgets; print("import ok")'
step "02.label"         "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication, QLabel; a=QApplication(sys.argv); w=QLabel("ok"); w.resize(60,20); w.show(); print("label ok")'
step "03.table"         "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication, QTableWidget; a=QApplication(sys.argv); t=QTableWidget(3,3); t.setCellWidget(0,0,None); t.resize(300,200); t.show(); print("table ok")'
step "04.splitter"      "$PY" -c 'import sys; from PySide6.QtCore import Qt; from PySide6.QtWidgets import QApplication, QSplitter, QLabel; a=QApplication(sys.argv); s=QSplitter(Qt.Vertical); s.addWidget(QLabel("a")); s.addWidget(QLabel("b")); s.resize(300,200); s.show(); print("splitter ok")'
step "05.qss"           "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication, QLabel; a=QApplication(sys.argv); a.setStyleSheet("QWidget{background:#111;color:#eee} QLabel#mono{font-family:Menlo}"); w=QLabel("x"); w.setObjectName("mono"); w.show(); print("qss ok")'
step "06.page_diag"     "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.remote import Remote; from app.pages import State, DiagPage; a=QApplication(sys.argv); w=DiagPage(Remote(), State()); w.show(); print("page diag ok")'
step "07.page_scan"     "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.remote import Remote; from app.pages import State, ScanPage; a=QApplication(sys.argv); w=ScanPage(Remote(), State()); w.show(); print("page scan ok")'
step "08.page_capture"  "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.remote import Remote; from app.pages import State, CapturePage; a=QApplication(sys.argv); w=CapturePage(Remote(), State()); w.show(); print("page capture ok")'
step "09.page_crack"    "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.remote import Remote; from app.pages import State, CrackPage; a=QApplication(sys.argv); w=CrackPage(Remote(), State()); w.show(); print("page crack ok")'
step "10.page_evil"     "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.remote import Remote; from app.pages import State, EvilPage; a=QApplication(sys.argv); w=EvilPage(Remote(), State()); w.show(); print("page evil ok")'
step "11.positions"     "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.positions import PositionsEditor; a=QApplication(sys.argv); w=PositionsEditor(); w.show(); print("positions ok")'
step "12.mainwindow"    "$PY" -c 'import sys; from PySide6.QtWidgets import QApplication; from app.theme import QSS; from app.main import MainWindow; a=QApplication(sys.argv); a.setStyleSheet(QSS); w=MainWindow(); w.resize(1180,760); w.show(); print("window ok")'

echo
echo "итог:"
cat "$OUT" | grep -E "^[0-9]{2}\." | sed 's/^/  /'
echo
echo "полный отчёт: $OUT"