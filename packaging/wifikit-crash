#!/bin/sh
# wifikit-crash: запустить GUI под gdb и сохранить C++-бэктрейс.
#
# Нужен, когда приложение падает по SIGSEGV/SIGBUS внутри Qt: Python-лог
# (faulthandler) показывает только app.exec(), а место падения видно лишь
# в нативном стеке.
#
# Запуск: wifikit-crash [секунды]      (по умолчанию ждём падения 180 с)
set +e

PREFIX="${WIFIKIT_PREFIX:-/usr/lib/wifikit}"
PY="${WIFIKIT_PY:-$PREFIX/venv/bin/python}"
[ -x "$PY" ] || PY="$(command -v python3)"
TIMEOUT="${1:-180}"
OUT="${2:-$HOME/wifikit-crash.txt}"

if ! command -v gdb >/dev/null; then
  cat >&2 <<'EOF'
gdb не установлен. Поставить:
  sudo apt install -y gdb
EOF
  exit 2
fi

echo "запускаю GUI под gdb; ожидание падения до ${TIMEOUT}с"
echo "отчёт: $OUT"

# SIGPIPE/SIGSEGV ловим, backtrace по всем потокам
gdb -q -batch \
  -ex "set pagination off" \
  -ex "set print thread-events off" \
  -ex "handle SIGPIPE nostop noprint pass" \
  -ex "run" \
  -ex "thread apply all bt 25" \
  --args "$PY" "$PREFIX/app/main.py" 2>&1 | tee "$OUT" | tail -40

echo
echo "готово: $OUT"
echo "Пришлите этот файл целиком — по нему видно функцию Qt, в которой падает."